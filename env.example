#required: OpenClaw gateway token
#secret
OPENCLAW_GATEWAY_TOKEN=example: openssl rand -hex 32

# Optional dedicated token for the native OpenClaw agent hooks.
# Leave blank to keep the native hook endpoints disabled.
#secret
OPENCLAW_HOOKS_TOKEN=example: openssl rand -hex 32

# Telegram accounts. The first agent defaults to main; repeated accounts use
# _02, _03, and so on.
#repeat-group: OPENCLAW_TELEGRAM suffix02 OPENCLAW_TELEGRAM_AGENT OPENCLAW_TELEGRAMTOKEN OPENCLAW_TELEGRAM_CHAT_ID OPENCLAW_TELEGRAM_DEFAULT OPENCLAW_TELEGRAM_HEARTBEAT_MINUTES
#repeat-optional-complete: OPENCLAW_TELEGRAM_HEARTBEAT_MINUTES
#repeat-unique: OPENCLAW_TELEGRAM_AGENT
#repeat-freeform: OPENCLAW_TELEGRAM_AGENT
#default-preset: main
OPENCLAW_TELEGRAM_AGENT=main

#secret
OPENCLAW_TELEGRAMTOKEN=

#discover-telegram-chat: OPENCLAW_TELEGRAMTOKEN
OPENCLAW_TELEGRAM_CHAT_ID=

#repeat-one-true: OPENCLAW_TELEGRAM_DEFAULT
#choices: 0 1
#default-preset: 1
OPENCLAW_TELEGRAM_DEFAULT=1

# Heartbeat interval in minutes for this agent; 0 disables scheduled heartbeats.
#default-preset: 0
OPENCLAW_TELEGRAM_HEARTBEAT_MINUTES=0

# Native OpenClaw providers may be added as their established *_API_KEY variables.

#repeat-group: OPENAI_V1 suffix OPENAI_V1_PROVIDER OPENAI_V1_URL OPENAI_V1_PORT OPENAI_V1_KEY OPENAI_V1_API_KEY_ALIAS OPENAI_V1_STREAM
OPENAI_V1_PROVIDER=

OPENAI_V1_URL=

#default-preset: 443
OPENAI_V1_PORT=443

#secret
OPENAI_V1_KEY=

#reverse-varname: OPENAI_V1_KEY
OPENAI_V1_API_KEY_ALIAS=

#default-preset: false
OPENAI_V1_STREAM=false

# Optional explicit default for a configured OpenAI-v1 provider.
OPENCLAW_OPENAI_V1_DEFAULT_LLM=

# Optional HTTP MCP servers. The first group is suffixless; repeated
# groups use _02, _03, and so on.
#repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
#repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
MCP_SERVER_NAME=

MCP_SERVER_URL=

#secret
MCP_SERVER_BEARER=

#choices: 0 1
#default-preset: 0
MCP_SERVER_ALLOW_PRIVATE=0

# Codex agent ids for this MCP server (CSV). Blank or * means all agents.
#default-preset: *
MCP_ALLOW=*

#choices: file sqlite mariadb postgres
#default-preset: file
NOTE_DB_BACKEND=file

#blank-if: NOTE_DB_BACKEND=file NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
#blank-if: NOTE_DB_BACKEND=sqlite NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
NOTE_DB_URL=127.0.0.1

NOTE_DB_PORT=5432

NOTE_DB_NAME=note

NOTE_DB_USER=note

#secret
NOTE_DB_PW=

NOTE_DB_PREFIX=note
